!macro customHeader
  !define MUI_FINISHPAGE_TITLE "Cyclia is ready"
  !define MUI_FINISHPAGE_TEXT "Cyclia is installed.$\r$\n$\r$\nThank you for using it. Cyclia was created by Naeem Ur Rehman and is shared for free so that more people can do good environmental science. If it helps your thesis or paper, please cite it (Help > About in the app shows the citation).$\r$\n$\r$\nCyclia has no funding. To support it: paypal.me/pdnaeem or revolut.me/pdnaeem."
  !define MUI_FINISHPAGE_LINK "Cyclia website and documentation"
  !define MUI_FINISHPAGE_LINK_LOCATION "https://github.com/pdnaeem/cyclia"
!macroend

!macro customWelcomePage
  !define MUI_WELCOMEPAGE_TITLE "Welcome to Cyclia ${VERSION}"
  !define MUI_WELCOMEPAGE_TEXT "Free, open-source life cycle assessment for students and researchers, following ISO 14040 and 14044. No programming needed.$\r$\n$\r$\nCreated by Naeem Ur Rehman, environmental scientist.$\r$\n$\r$\nCyclia does not include any database. After installing, you can learn with the built-in tutorial database or connect your own ecoinvent licence.$\r$\n$\r$\nClick Next to continue."
  !insertmacro MUI_PAGE_WELCOME
!macroend
